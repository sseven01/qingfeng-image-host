PORT=3000
APP_PASSWORD=change-this-password
SESSION_SECRET=change-this-random-secret
BASE_URL=http://localhost:3000
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads
DATA_DIR=data
THUMB_DIR=thumbs
TRUST_PROXY=false
COOKIE_SECURE=false
# Token 鉴权（可选）：给主题/外部 AI 工具用，与后台密码会话互不影响
# API_TOKEN=只读token-随机字符串        # 开放 /api/tree /api/items /api/images/search
# API_TOKEN_WRITE=读写token-随机字符串  # 额外开放 /api/upload
