# 全部环境变量均为可选覆盖；不写 .env 时用 CLI（node cli.js password / token）
# 和后台「设置」管理配置（存 data/config.json）。环境变量与配置文件同名时环境变量优先。
PORT=3000
# APP_PASSWORD=
# SESSION_SECRET=            # 不设置则首次启动自动生成
# BASE_URL=https://img.example.com
# MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads
DATA_DIR=data
THUMB_DIR=thumbs
TRUST_PROXY=false
COOKIE_SECURE=false
# API_TOKEN=                 # 只读 Token，建议 node cli.js token 生成
# API_TOKEN_WRITE=           # 读写 Token（上传），不上传不要设置
